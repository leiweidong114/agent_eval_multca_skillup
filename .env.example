# Copy to .env in the repository root. Never commit .env.
LITELLM_PROFILE=litellm
LITELLM_API_BASE=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_MODEL=glm-4.5-air
# Sent as HTTP headers on every LiteLLM catalog, inference, Judge, and trace-key request.
# Web requests override LITELLM_X_USER_ACCOUNT with the employee number from login.
LITELLM_USER_AGENT=OpenAI/Python
LITELLM_X_COOKIE=11
LITELLM_X_USER_ACCOUNT=local
LITELLM_JUDGE_MODEL=glm-4.5-air
LLM_JUDGE_ENABLED=true
LLM_JUDGE_REQUIRED=false
LLM_JUDGE_TIMEOUT_SECONDS=120
LLM_JUDGE_MAX_EVIDENCE_CHARS=60000
LLM_JUDGE_TEMPERATURE=0
AGENT_TEST_MODEL=glm-4.5-air
LITELLM_PROTOCOL=openai_compatible
LITELLM_REASONING=true
LITELLM_CONTEXT_WINDOW=200000
LITELLM_MAX_OUTPUT_TOKENS=32000
# JSON objects used for optional per-Agent routing and Web-created profiles.
LITELLM_AGENT_MODELS_JSON={}
LITELLM_GATEWAY_MODELS_JSON={}
MODEL_PROFILES_JSON={}
# Dashboard login is separate from the inference API key; not sent to /chat/completions.
LITELLM_USERNAME=admin
LITELLM_PASSWORD=
# PostgreSQL credentials are separate from the LiteLLM dashboard login.
# DATABASE_URL may replace the five DATABASE_* connection fields below.
DATABASE_URL=
DATABASE_ENABLED=true
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=litellm
DATABASE_USER=litellm
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSLMODE=prefer
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_TRACE_ENABLED=true
DATABASE_TRACE_INCLUDE_CONTENT=false
DATABASE_TRACE_LOOKAROUND_SECONDS=10
DATABASE_TRACE_LIMIT=500
DATABASE_RETENTION_DAYS=30
DATABASE_MAX_CONTENT_CHARS=20000
# JSON arrays/objects. Windows paths are safest with forward slashes.
SCHEMATIC_SKILLS_JSON=["schematic-pipeline","signal-interface-generation","schematic-layout-codegen","schematic-web-apply"]
# Evaluators are selected by stable ids. External paths may be absolute or repository-relative.
DEFAULT_SKILL_EVALUATOR=generic
DEFAULT_SCHEMATIC_EVALUATOR=schematic-default
# Per-task settings are normally written by the Web settings page.
SCHEMATIC_TASK_PROFILES_JSON={"block_to_schematic":{"skills":["schematic-pipeline","signal-interface-generation","schematic-layout-codegen","schematic-web-apply"],"evaluator_id":"schematic-default"},"block_to_signal_list":{"skills":["signal-interface-generation"],"evaluator_id":"schematic-default"},"signal_list_to_schematic":{"skills":["schematic-layout-codegen","schematic-web-apply"],"evaluator_id":"schematic-default"}}

# Historical metrics storage and source-data API.
# Only put the scheme, server IP/name and port in the base URL. The query path is
# appended by the backend. Example: http://10.0.0.8:8080
SCHEMATIC_DATA_API_BASE_URL=
SCHEMATIC_DATA_QUERY_PATH=/schematic/schematicData/query
# Cookie sent by the evaluation backend to the Java schematic-data service.
# Example: JSESSIONID=replace-me; other_cookie=replace-me
SCHEMATIC_DATA_API_COOKIE=
SCHEMATIC_DATA_WRITE_PATH=/schematic/schematicData/insert
SCHEMATIC_DATA_API_TIMEOUT_SECONDS=15
SCHEMATIC_DATA_QUERY_PAGE_SIZE=20
SCHEMATIC_DATA_QUERY_MAX_PAGES=50
# Derived metrics and jobs are persisted locally; page responses use in-process TTL/LRU.
SESSION_METRICS_SQLITE_PATH=backend/data/session_metrics.sqlite3
AGENT_EVAL_CACHE_TTL_SECONDS=300
AGENT_EVAL_CACHE_MAX_SIZE=1000
EVALUATOR_PLUGIN_PATHS_JSON=[]
# Optional Skill roots for private/intranet-only Skills.
EXTERNAL_SKILL_PATHS_JSON=[]
AGENT_PATHS_JSON={"justdo":"D:/tools/JustDo/JustDo-agent.exe"}
JUSTDO_AGENT_EXECUTABLE=D:/tools/JustDo/JustDo-agent.exe
AGENT_EVAL_WORKERS=6
# Optional Prism data directory. Empty uses backend/model_eval_data.
MODEL_AGENT_EVAL_DATA_DIR=
PRISM_ADMIN_USERNAME=admin
PRISM_ADMIN_PASSWORD=CHANGE_ME
PRISM_SECURE_COOKIES=0
PRISM_ALLOW_ONLINE_BENCHMARK_INSTALL=0

# Windows project-local runtime. Relative paths are resolved from the repository root.
PYTHON_EXECUTABLE=backend/.runtime/windows/python/Scripts/python.exe
NODE_EXECUTABLE=backend/.runtime/windows/node/node.exe
NPM_EXECUTABLE=backend/.runtime/windows/node/npm.cmd
GO_EXECUTABLE=backend/.runtime/windows/go/bin/go.exe
SKILLUP_EXECUTABLE=backend/.tools/windows/skill-up.exe
MULTICA_EXECUTABLE=backend/.runtime/windows/bin/multica-eval-runtime.exe

# Root start.ps1 / start-all.ps1 service settings.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
SERVICE_START_TIMEOUT_SECONDS=45
# Optional authenticated JustDo HTTP bridge. When set, JustDo evaluations use
# the bundled justdo-http-agent proxy instead of a local JustDo-agent process.
JUSTDO_HTTP_URL=
JUSTDO_HTTP_TOKEN=

# Recalculate changed, non-evaluation sessions from the latest 24 hours.
SESSION_METRICS_AUTO_ENABLED=true
SESSION_METRICS_AUTO_INTERVAL_SECONDS=3600
SESSION_METRICS_AUTO_INITIAL_DELAY_SECONDS=60
SESSION_METRICS_AUTO_MAX_SESSIONS=100
SESSION_METRICS_AUTO_USE_LLM_JUDGE=true
SESSION_METRICS_AUTO_USER_ID=system
