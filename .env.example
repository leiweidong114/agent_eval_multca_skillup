# Copy to .env in the repository root. Never commit .env.
LITELLM_API_BASE=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_MODEL=glm-4.5-air
LITELLM_JUDGE_MODEL=glm-4.5-air
# Dashboard login is separate from the inference API key; not sent to /chat/completions.
LITELLM_USERNAME=admin
LITELLM_PASSWORD=
# PostgreSQL credentials are separate from the LiteLLM dashboard login.
DATABASE_URL=postgresql://litellm:CHANGE_ME@127.0.0.1:5432/litellm
