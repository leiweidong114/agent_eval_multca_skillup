# Copy this file to .env in the repository root. Never commit the real .env.

# LiteLLM gateway and the default deployment used by evaluations.
LITELLM_PROFILE=litellm_glm_4_7
LITELLM_API_BASE=http://8.137.196.46:4000/v1
LITELLM_MODEL=glm-4.7
LITELLM_API_KEY=sk-your-evaluation-key

# Required for run-scoped virtual keys and exact model verification.
LITELLM_MASTER_KEY=sk-your-litellm-master-key

# PostgreSQL: prefer one complete URL. URL-encode special characters in credentials.
DATABASE_URL=postgresql://agent_eval_reader:your-password@8.137.196.46:5432/litellm
DATABASE_ENABLED=true

# Alternatively, leave DATABASE_URL empty and use the separate fields below.
# DATABASE_HOST=8.137.196.46
# DATABASE_PORT=5432
# DATABASE_NAME=litellm
# DATABASE_USER=agent_eval_reader
# DATABASE_PASSWORD=your-password

# Optional LLM judge override.
LITELLM_JUDGE_ENABLED=true
LITELLM_JUDGE_PROFILE=litellm_glm_4_7
LITELLM_JUDGE_MODEL=glm-4.7
# Fake-login cookie signing. Generate a long random value on every deployment.
AGENT_EVAL_SESSION_SECRET=replace-with-at-least-32-random-characters
AGENT_EVAL_SECURE_COOKIE=false

# Sent only by profiles marked internal_gateway: true in backend/config/models.yaml.
LITELLM_USER_AGENT=OpenAI/Python
LITELLM_X_COOKIE=11
