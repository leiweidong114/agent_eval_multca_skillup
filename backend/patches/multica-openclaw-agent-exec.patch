+// buildOpenclawAgentExecArgs uses the stable, isolated one-shot protocol
+// introduced by OpenClaw 2026.8. Unlike `openclaw agent --local`, agent-exec
+// exits after emitting its JSON envelope, so evaluation workers cannot remain
+// parked after the model has already returned a complete answer.
+func buildOpenclawAgentExecArgs(prompt string, opts ExecOptions) []string {
+	args := []string{"agent", "exec", "--json"}
+	if config := strings.TrimSpace(os.Getenv("OPENCLAW_CONFIG_PATH")); config != "" {
+		args = append(args, "--config", config)
+	}
+	if state := strings.TrimSpace(os.Getenv("OPENCLAW_STATE_DIR")); state != "" {
+		args = append(args, "--state-dir", state)
+	}
+	if opts.Cwd != "" {
+		args = append(args, "--cwd", opts.Cwd)
+	}
+	if model := strings.TrimSpace(os.Getenv("AGENT_EVAL_OPENCLAW_EXEC_MODEL")); model != "" {
+		args = append(args, "--model", model)
+	}
+	if opts.Timeout > 0 {
+		args = append(args, "--timeout", fmt.Sprintf("%d", int(opts.Timeout.Seconds())))
+	}
+	if opts.SystemPrompt != "" {
+		prompt = opts.SystemPrompt + "\n\n" + prompt
+	}
+	return append(args, prompt)
+}
